<Layouts.app flash={@flash}>
  <section
    id="worldloom"
    data-mode={@mode}
    data-event-window-size={map_size(@trusted_events)}
    class="worldloom-shell"
  >
    <div
      id="loom-canvas"
      phx-hook="Worldloom"
      phx-update="ignore"
      data-snapshot-version={@snapshot_version}
      data-window-end={@window_end}
      data-anchor-at={@anchor_at}
      data-commit-watermark={@commit_watermark}
      data-scene-diagnostics-enabled={@scene_diagnostics? && "true"}
      data-display-events={Jason.encode!(@display_events)}
      data-memory-events={Jason.encode!(@memory_events)}
      data-instructions={Jason.encode!(@instructions)}
      data-instruction-count={length(@instructions)}
      data-scaffold={Jason.encode!(@scaffold)}
      data-scaffold-count={length(@scaffold)}
      data-ambient={@ambient && Jason.encode!(Instruction.from_event(@ambient))}
      data-gesture-lane={@gesture_lane}
      data-live={to_string(@live?)}
      role="img"
      aria-label="A living public tapestry woven from public signals. Use arrow keys to inspect formations."
      tabindex="0"
      class="loom-stage"
    >
      <canvas aria-hidden="true"></canvas>
    </div>

    <section
      id="worldloom-introduction"
      class="worldloom-introduction"
      aria-labelledby="worldloom-title"
    >
      <p class="eyebrow">A living public record</p>
      <h1 id="worldloom-title">The world is weaving itself.</h1>
      <p>Public signals, becoming one persistent fabric.</p>
      <span aria-hidden="true">Move left through earlier hours.</span>
    </section>

    <header class="worldloom-header">
      <.link id="wordmark" navigate={~p"/"} class="wordmark" aria-label="Worldloom live weave">
        <span class="wordmark-glyph" aria-hidden="true"></span> Worldloom
      </.link>

      <div class="header-context">
        <span id="utc-chapter" class="utc-chapter">{@utc_chapter} UTC</span>
        <span id="viewer-count" class="viewer-count">
          <span class="viewer-pulse" aria-hidden="true"></span>
          {@viewer_count} viewing
        </span>
        <details id="mobile-worldloom-menu" class="mobile-worldloom-menu">
          <summary aria-label="Open Worldloom navigation">
            <.icon name="hero-ellipsis-horizontal" class="size-5" />
          </summary>
          <nav aria-label="Worldloom mobile navigation">
            <.link navigate={~p"/chapters"}>Archive</.link>
            <.link navigate={~p"/about"}>About</.link>
            <button type="button" phx-click="share" data-preserve-selection>Share</button>
          </nav>
        </details>
        <nav class="worldloom-nav" aria-label="Worldloom">
          <.link id="archive-link" navigate={~p"/chapters"}>Archive</.link>
          <.link id="about-link" navigate={~p"/about"}>About</.link>
          <button
            id="share-worldloom"
            type="button"
            phx-click="share"
            data-preserve-selection
          >
            Share
          </button>
        </nav>
        <p id="share-status" phx-update="ignore" class="sr-only" aria-live="polite"></p>
        <div id="share-fallback-field" phx-update="ignore" hidden>
          <label for="share-fallback">Permanent link</label>
          <input id="share-fallback" type="url" readonly value="" />
        </div>
      </div>
    </header>

    <div id="live-edge" class="live-edge" aria-label="Live edge">
      <span class="live-edge-seed" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span>Live</span>
    </div>

    <aside
      id="signal-legend"
      data-wikimedia-state={legend_health_state(@feed_health, @source_eligibility, :wikimedia)}
      data-usgs-state={legend_health_state(@feed_health, @source_eligibility, :usgs)}
      data-weather-state={legend_health_state(@feed_health, @source_eligibility, :open_meteo)}
      class="signal-legend"
      aria-label="Signal legend"
    >
      <div data-legend-layout="desktop" class="legend-desktop" aria-label="Signal legend">
        <div class="legend-heading">
          <p class="eyebrow">Material key</p>
          <h2>Signals in the weave</h2>
        </div>
        <.legend_entries
          feed_health={@feed_health}
          source_eligibility={@source_eligibility}
          id_prefix=""
        />
      </div>

      <details data-legend-layout="compact" class="legend-compact">
        <summary id="signal-legend-toggle" class="legend-toggle">
          <span>Read the signals</span>
          <small>8 distinct materials</small>
          <.icon name="hero-chevron-down" class="size-4" />
        </summary>
        <div class="legend-body">
          <div class="legend-heading">
            <p class="eyebrow">Material key</p>
            <h2>Signals in the weave</h2>
          </div>
          <.legend_entries
            feed_health={@feed_health}
            source_eligibility={@source_eligibility}
            id_prefix="compact-"
          />
        </div>
      </details>
    </aside>

    <div
      id="gesture-dock"
      aria-disabled={to_string(not @live? or not @at_live_edge or not is_nil(@cooldown_until))}
      class="gesture-dock"
    >
      <h2>Touch the loom</h2>
      <form
        id="gesture-lane-form"
        phx-change="lane-change"
        phx-submit="weave-gesture"
        class="gesture-form"
      >
        <div class="gesture-actions" role="group" aria-label="Weave a visitor gesture">
          <button
            :for={
              {gesture, label} <- [{"tug", "Tug"}, {"knot", "Knot"}, {"illuminate", "Illuminate"}]
            }
            id={"gesture-#{gesture}"}
            type="submit"
            name="gesture"
            value={gesture}
            class="gesture-button"
            data-gesture={gesture}
            aria-label={label}
            aria-describedby={"gesture-#{gesture}-description"}
            phx-disable-with="Weaving…"
            disabled={not @live? or not @at_live_edge or not is_nil(@cooldown_until)}
          >
            <span class="gesture-mark" aria-hidden="true"></span>
            <span class="gesture-copy">
              <strong>{label}</strong>
              <small id={"gesture-#{gesture}-description"}>{gesture_description(gesture)}</small>
            </span>
          </button>
        </div>

        <div class="lane-control">
          <label for="gesture-lane">Vertical lane</label>
          <input
            id="gesture-lane"
            name="lane"
            type="range"
            min="0"
            max="1"
            step="0.05"
            value={@gesture_lane}
            disabled={not @live? or not @at_live_edge}
            aria-label="Gesture vertical lane"
          />
        </div>
      </form>

      <p id="gesture-status" class="gesture-status" aria-live="polite">
        {@gesture_status}
        <span
          :if={@live? and @cooldown_remaining}
          id="gesture-countdown"
          class="gesture-countdown"
          aria-hidden="true"
        >{@cooldown_remaining}s</span>
        <span :if={@live? and @cooldown_seconds} class="sr-only">
          Gesture controls return in {@cooldown_seconds} seconds.
        </span>
      </p>
    </div>

    <.link
      :if={not @live? or not @at_live_edge}
      id="return-live"
      navigate={~p"/"}
      class="return-live"
    >
      Return live
    </.link>

    <div id="timeline-controls" class="timeline-controls">
      <div id="timeline" class="timeline" aria-hidden="true">
        <span>Earlier</span>
        <i></i>
        <span>Now</span>
      </div>
      <div
        id="timeline-scale"
        class="timeline-scale"
        role="group"
        aria-label="Timeline scale"
        aria-describedby="timeline-range"
      >
        <button
          :for={{label, seconds} <- [{"1m", 60}, {"5m", 300}, {"15m", 900}]}
          id={"timeline-scale-#{seconds}"}
          type="button"
          class="timeline-scale-button"
          data-duration-seconds={seconds}
          data-touch-target="44"
          aria-pressed={to_string(seconds == 60)}
          aria-describedby="timeline-range"
        >
          {label}
        </button>
      </div>
      <p id="timeline-range" class="timeline-range">1 minute · UTC range unavailable</p>
    </div>

    <aside
      :if={@selected_detail}
      id="signal-detail"
      class="signal-detail"
      aria-live="polite"
      phx-window-keydown="clear-selection"
      phx-key="Escape"
    >
      <div id="mobile-detail-sheet">
        <p class="eyebrow">Formation detail</p>
        <div>
          <p class="detail-summary">{@selected_detail.summary}</p>
          <p class="detail-meta">{@selected_detail.source} · {@selected_detail.occurred_at}</p>
        </div>
        <label class="share-field" for="share-link">
          Permalink <input id="share-link" type="url" readonly value={@permalink || "/"} />
        </label>
      </div>
    </aside>

    <section id="archive-panel" data-active={@mode == :archive || nil} class="worldloom-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Persistent public record</p>
          <h1>UTC chapters</h1>
        </div>
        <.link navigate={~p"/"}>Close</.link>
      </div>
      <ol id="archive-rows" phx-update="stream" class="chapter-list">
        <li :for={{dom_id, chapter} <- @streams.archive_rows} id={dom_id}>
          <.link navigate={
            ~p"/chapters/#{Date.to_iso8601(chapter.date)}/#{chapter.first_sequence}"
          }>
            <span>{chapter.date}</span>
            <small>{chapter.count} formations</small>
          </.link>
        </li>
      </ol>
    </section>

    <section
      id="about-panel"
      data-active={@mode == :about || nil}
      class="worldloom-panel about-panel"
    >
      <div class="panel-heading">
        <div>
          <p class="eyebrow">A shared instrument</p>
          <h1>About Worldloom</h1>
        </div>
        <.link navigate={~p"/"}>Close</.link>
      </div>
      <p class="about-lede">
        Worldloom is one living public record. Activity from across the world enters as fiber,
        tension, atmosphere, and light—then remains part of the same shared fabric.
      </p>
      <div class="about-sections">
        <section>
          <p class="eyebrow">The material</p>
          <h2>Public change, given form</h2>
          <p>
            Wikimedia edits extend connective threads. Earthquakes tighten ember knots. Weather
            changes the surrounding field. The work is interpretive, not an alerting tool.
          </p>
        </section>
        <section>
          <p class="eyebrow">Your touch</p>
          <h2>Shape the present, never rewrite the past</h2>
          <p>
            Tug bends a strand, Knot joins two paths, and Illuminate awakens a junction. Every
            gesture appears only after it becomes part of the persistent record.
          </p>
        </section>
        <section>
          <p class="eyebrow">A shared memory</p>
          <h2>The weave survives the room</h2>
          <p>
            Committed formations live in PostgreSQL and reopen through stable UTC chapter links.
            Connected browsers receive the same ordered artifact.
          </p>
        </section>
        <section>
          <p class="eyebrow">Privacy</p>
          <h2>No identity enters the artwork</h2>
          <p>
            There are no accounts, names, chat messages, uploads, profiles, or public cursors.
            Anonymous browser and network values exist only long enough to enforce contribution
            limits.
          </p>
        </section>
        <section>
          <p class="eyebrow">Access</p>
          <h2>The canvas is not the only way in</h2>
          <p>
            Keyboard, pointer, and touch controls share the same actions. Reduced motion, visible
            focus, structural signal shapes, and textual formation summaries remain available.
          </p>
        </section>
      </div>
      <div id="source-attribution" class="source-attribution">
        <h2>Public sources</h2>
        <a href="https://www.mediawiki.org/wiki/EventStreams" rel="noreferrer">
          <strong>Wikimedia EventStreams</strong>
          <span>Connective strands from four-second aggregates; no page text or editor identity.</span>
        </a>
        <a href="https://docs.bsky.app/blog/jetstream" rel="noreferrer">
          <strong>Bluesky Jetstream</strong>
          <span>Conversation fans from action counts; no post text or identity.</span>
        </a>
        <a href="https://ris-live.ripe.net/manual/" rel="noreferrer">
          <strong>RIPE RIS Live</strong>
          <span>Route forks from routing totals; no prefixes or peers.</span>
        </a>
        <a href="https://solana.com/docs/rpc/websocket/slotsubscribe" rel="noreferrer">
          <strong>Solana slot progression</strong>
          <span>Slot beads from bounded progression summaries; no transactions or wallet identity.</span>
        </a>
        <a href="https://docs.drand.love/developer/API-v2/drand-http-api/" rel="noreferrer">
          <strong>drand Quicknet</strong>
          <span>Crystalline pulses from exact rounds; structural validation, not signature verification.</span>
        </a>
        <a href="https://earthquake.usgs.gov/" rel="noreferrer">
          <strong>USGS Earthquake Hazards</strong>
          <span>Rupture rings from public observations; artistic context, not an alert.</span>
        </a>
        <a href="https://open-meteo.com/" rel="noreferrer">
          <strong>Open-Meteo</strong>
          <span>One shared atmosphere from twelve fixed anchors; never a visitor location.</span>
        </a>
        <p class="source-attribution-posture">
          All seven public sources are enabled by default. Operators can isolate an unhealthy
          provider without switching off the rest of the world. Browsers never contact providers
          directly.
        </p>
      </div>
      <p class="about-technology">
        Worldloom is built with Phoenix LiveView, OTP, PubSub, Presence, PostgreSQL, and a
        deterministic Canvas 2D renderer. <a
          href="https://github.com/romankhadka/worldloom"
          rel="noreferrer"
        >Read the public source</a>.
      </p>
    </section>

    <p id="live-summary" class="sr-only" aria-live="polite">
      {@semantic_summary}
    </p>

    <div id="accessible-formations" phx-update="stream" class="sr-only">
      <button
        :for={{dom_id, formation} <- @streams.accessible_formations}
        id={dom_id}
        type="button"
        phx-click="select-formation"
        phx-value-sequence={formation["sequence"]}
      >
        {formation["summary"]}
      </button>
    </div>

    <noscript>
      <p class="noscript-note">
        Worldloom needs JavaScript to draw the living fabric. Its public source, privacy contract, and data-source documentation remain available in the repository.
      </p>
    </noscript>
  </section>
</Layouts.app>
